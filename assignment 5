
#include <stdio.h>
#include <string.h>

#define MAX_LEN 200

int main()
{
    int choice;
    char str1[MAX_LEN], str2[MAX_LEN];
    char dest[MAX_LEN * 2];
    char ch;
    size_t n;
    char *pos;

    do
    {
        printf("\n========== STRING OPERATIONS MENU ==========\n");
        printf("1. String Length (strlen)\n");
        printf("2. Copy String (strcpy)\n");
        printf("3. Copy N Characters (strncpy)\n");
        printf("4. Concatenate Strings (strcat)\n");
        printf("5. Concatenate N Characters (strncat)\n");
        printf("6. Compare Strings (strcmp)\n");
        printf("7. Compare First N Characters (strncmp)\n");
        printf("8. Find First Occurrence of Character (strchr)\n");
        printf("9. Find Last Occurrence of Character (strrchr)\n");
        printf("10. Find Substring (strstr)\n");
        printf("0. Exit\n");
        printf("============================================\n");

        printf("Enter your choice: ");
        scanf("%d", &choice);
        getchar();

        switch(choice)
        {
            case 1:
                printf("Enter a string: ");
                fgets(str1, MAX_LEN, stdin);
                str1[strcspn(str1, "\n")] = '\0';

                printf("Length of string = %zu\n", strlen(str1));
                break;

            case 2:
                printf("Enter first string: ");
                fgets(str1, MAX_LEN, stdin);
                str1[strcspn(str1, "\n")] = '\0';

                strcpy(dest, str1);

                printf("Copied string = %s\n", dest);
                break;

            case 3:
                printf("Enter first string: ");
                fgets(str1, MAX_LEN, stdin);
                str1[strcspn(str1, "\n")] = '\0';

                printf("Enter number of characters to copy: ");
                scanf("%zu", &n);
                getchar();

                if(n >= sizeof(dest))
                    n = sizeof(dest) - 1;

                strncpy(dest, str1, n);
                dest[n] = '\0';

                printf("Copied string = %s\n", dest);
                break;

            case 4:
                printf("Enter first string: ");
                fgets(str1, MAX_LEN, stdin);
                str1[strcspn(str1, "\n")] = '\0';

                printf("Enter second string: ");
                fgets(str2, MAX_LEN, stdin);
                str2[strcspn(str2, "\n")] = '\0';

                strcpy(dest, str1);

                if(strlen(str1) + strlen(str2) < sizeof(dest))
                {
                    strcat(dest, str2);
                    printf("Concatenated string = %s\n", dest);
                }
                else
                {
                    printf("Strings are too long to concatenate.\n");
                }
                break;

            case 5:
                printf("Enter first string: ");
                fgets(str1, MAX_LEN, stdin);
                str1[strcspn(str1, "\n")] = '\0';

                printf("Enter second string: ");
                fgets(str2, MAX_LEN, stdin);
                str2[strcspn(str2, "\n")] = '\0';

                printf("Enter number of characters to concatenate: ");
                scanf("%zu", &n);
                getchar();

                strcpy(dest, str1);

                strncat(dest, str2,
                        sizeof(dest) - strlen(dest) - 1 < n ?
                        sizeof(dest) - strlen(dest) - 1 : n);

                printf("Concatenated string = %s\n", dest);
                break;

            case 6:
                printf("Enter first string: ");
                fgets(str1, MAX_LEN, stdin);
                str1[strcspn(str1, "\n")] = '\0';

                printf("Enter second string: ");
                fgets(str2, MAX_LEN, stdin);
                str2[strcspn(str2, "\n")] = '\0';

                if(strcmp(str1, str2) == 0)
                    printf("Both strings are equal.\n");
                else
                    printf("Both strings are not equal.\n");
                break;

            case 7:
                printf("Enter first string: ");
                fgets(str1, MAX_LEN, stdin);
                str1[strcspn(str1, "\n")] = '\0';

                printf("Enter second string: ");
                fgets(str2, MAX_LEN, stdin);
                str2[strcspn(str2, "\n")] = '\0';

                printf("Enter number of characters to compare: ");
                scanf("%zu", &n);
                getchar();

                if(strncmp(str1, str2, n) == 0)
                    printf("First %zu characters are equal.\n", n);
                else
                    printf("First %zu characters are not equal.\n", n);
                break;

            case 8:
                printf("Enter a string: ");
                fgets(str1, MAX_LEN, stdin);
                str1[strcspn(str1, "\n")] = '\0';

                printf("Enter character to search: ");
                scanf("%c", &ch);
                getchar();

                pos = strchr(str1, ch);

                if(pos != NULL)
                    printf("First occurrence found at position %ld\n",
                           (long)(pos - str1) + 1);
                else
                    printf("Character not found.\n");
                break;

            case 9:
                printf("Enter a string: ");
                fgets(str1, MAX_LEN, stdin);
                str1[strcspn(str1, "\n")] = '\0';

                printf("Enter character to search: ");
                scanf("%c", &ch);
                getchar();

                pos = strrchr(str1, ch);

                if(pos != NULL)
                    printf("Last occurrence found at position %ld\n",
                           (long)(pos - str1) + 1);
                else
                    printf("Character not found.\n");
                break;

            case 10:
                printf("Enter main string: ");
                fgets(str1, MAX_LEN, stdin);
                str1[strcspn(str1, "\n")] = '\0';

                printf("Enter substring to search: ");
                fgets(str2, MAX_LEN, stdin);
                str2[strcspn(str2, "\n")] = '\0';

                pos = strstr(str1, str2);

                if(pos != NULL)
                    printf("Substring found at position %ld\n",
                           (long)(pos - str1) + 1);
                else
                    printf("Substring not found.\n");
                break;

            case 0:
                printf("Exiting program...\n");
                break;

            default:
                printf("Invalid choice! Please try again.\n");
        }

    } while(choice != 0);

    return 0;
}

