
#include <stdio.h>

struct Robot
{
    int robot_id;
    float joint_angle;
    float temperature;
    float torque;
    int status;
};

int main()
{
    struct Robot r;
    FILE *fp;
    int n, i;
    int abnormal = 0;

    fp = fopen("robot_data.txt", "a");

    if(fp == NULL)
    {
        printf("Error opening file!\n");
        return 1;
    }

    printf("Enter number of robot records: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++)
    {
        printf("\nEnter details of Robot %d\n", i + 1);

        printf("Enter Robot ID: ");
        scanf("%d", &r.robot_id);

        printf("Enter Joint Angle: ");
        scanf("%f", &r.joint_angle);

        printf("Enter Motor Temperature (C): ");
        scanf("%f", &r.temperature);

        printf("Enter Torque Value (Nm): ");
        scanf("%f", &r.torque);

        printf("Enter Operational Status (1=ON, 0=OFF): ");
        scanf("%d", &r.status);

        fprintf(fp, "%d %.2f %.2f %.2f %d\n",
                r.robot_id,
                r.joint_angle,
                r.temperature,
                r.torque,
                r.status);
    }

    fclose(fp);

    printf("\nRobot records saved successfully!\n");

    // Read historical records

    fp = fopen("robot_data.txt", "r");

    if(fp == NULL)
    {
        printf("Error reading file!\n");
        return 1;
    }

    printf("\n========== HISTORICAL ROBOT ANALYSIS ==========\n");

    while(fscanf(fp, "%d %f %f %f %d",
                 &r.robot_id,
                 &r.joint_angle,
                 &r.temperature,
                 &r.torque,
                 &r.status) == 5)
    {
        printf("\nRobot ID: %d\n", r.robot_id);
        printf("Joint Angle: %.2f\n", r.joint_angle);
        printf("Motor Temperature: %.2f C\n", r.temperature);
        printf("Torque: %.2f Nm\n", r.torque);

        if(r.status == 0)
        {
            printf("Status: OFFLINE\n");
        }
        else
        {
            printf("Status: ONLINE\n");
        }

        abnormal = 0;

        if(r.temperature > 80)
        {
            printf("WARNING: Abnormal motor temperature!\n");
            abnormal = 1;
        }

        if(r.torque > 100)
        {
            printf("WARNING: Excessive torque detected!\n");
            abnormal = 1;
        }

        if(abnormal == 1)
        {
            printf("ALERT: Potential mechanical failure!\n");
        }
        else
        {
            printf("Condition: Normal\n");
        }

        printf("--------------------------------------\n");
    }

    fclose(fp);

    printf("\nHistorical analysis completed.\n");

    return 0;
}
